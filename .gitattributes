# 텍스트 파일은 LF로 정규화
* text=auto eol=lf

# 셸 스크립트는 반드시 LF
*.sh text eol=lf

# Java / TypeScript / 설정 파일
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf

# 바이너리 파일은 변환 제외
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
